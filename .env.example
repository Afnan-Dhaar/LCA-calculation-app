# ===========================================================================
# Environment Configuration Template for PCF Brightway Studio
# ===========================================================================

# 1. PostgreSQL Database Connection
DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/pcf_lca

# 2. Brightway Configuration
BW_PROJECT=pcf_lca_api

# 3. Security & Authentication
# Set to 'true' in staging/production to require X-API-Key or Bearer token
API_SECURITY_ENABLED=false
API_KEY=lca-studio-secret-2026

# 4. Rate Limiting & Throttling
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
MAX_PAYLOAD_BYTES=10485760

# 5. Service Ports
PORT=8000
HOST=0.0.0.0
